# Copia este archivo a .env.local para desarrollo (pnpm dev).
# URL del core usada por el rewrite /core-api de Next.js.
CORE_API_URL=http://localhost:8080
# URL base del WebSocket del control remoto. Vacía en producción (mismo origen vía nginx);
# en desarrollo, ws://localhost:8080.
NEXT_PUBLIC_CORE_WS_URL=ws://localhost:8080
# Puerto publicado de nginx en Docker.
NGINX_HOST_PORT=4000
