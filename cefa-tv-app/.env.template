# Copia este archivo a .env para Docker (make up). Para desarrollo con pnpm dev usa .env.local
# y descomenta las dos líneas marcadas como desarrollo.

# Desarrollo: URL del core usada por el rewrite /core-api de Next.js.
# CORE_API_URL=http://localhost:8080

# URL base del WebSocket (control remoto, terminal y vista previa). DEBE ir vacía en Docker y en
# producción: el valor se incrusta en la web al compilarla y el navegador usa el mismo origen a
# través de nginx. Con un valor aquí (por ejemplo ws://localhost:8080) esas funciones dejan de
# funcionar fuera de tu ordenador.
NEXT_PUBLIC_CORE_WS_URL=

# Desarrollo: los WebSocket no pasan por los rewrites de Next.js, así que en .env.local hay que
# apuntar directamente al core.
# NEXT_PUBLIC_CORE_WS_URL=ws://localhost:8080

# Puerto publicado de nginx en Docker.
NGINX_HOST_PORT=4000
