# Copia este fichero a .env y ajusta los valores. El fichero .env no se versiona.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

DB_NAME=cefatv
DB_USER=cefatv
DB_PASSWORD=
DB_PORT=5432
DB_BIND_ADDRESS=127.0.0.1

# Almacenamiento S3 (Garage). S3_ACCESS_KEY debe ser GK + 24 hex y S3_SECRET_KEY 64 hex:
#   S3_ACCESS_KEY=GK$(openssl rand -hex 12)   S3_SECRET_KEY=$(openssl rand -hex 32)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=cefa-tv-media
S3_REGION=garage
S3_API_PORT=3900
S3_BIND_ADDRESS=127.0.0.1
GARAGE_RPC_SECRET=
GARAGE_CAPACITY=100G
GARAGE_IMAGE=dxflrs/garage:v2.1.0

# Aracast: contraseñas de respaldo para los players que no tengan una propia (se configuran por player en la web).
ARACAST_SSH_PASSWORDS=
ARACAST_FTP_PASSWORD=
ARACAST_SECRET_KEY=
# Servidores NTP internos con los que sincronizar la hora de los Aracast (los players suelen no tener DNS).
ARACAST_NTP_SERVERS=10.21.34.10,10.21.35.2

JWT_SECRET=
COOKIE_SECURE=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=

PUBLIC_URL=

# Repositorio git del reproductor, que aparece en las instrucciones de instalación de Añadir reproductor.
PLAYER_REPO_URL=ssh://git@git.cefa.es:2222/it/cefa-tv-player.git

APP_BASE_URL=http://localhost:4000

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=
MICROSOFT_AUTO_PROVISION=false
MICROSOFT_DEFAULT_GROUP_ID=
